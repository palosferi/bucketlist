# Copy to .env and fill in. Never commit .env.

# --- required in production -------------------------------------------------

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to start in production if this is missing or under 32 chars.
SESSION_SECRET=

# Absolute public URL. Email links are built from it, so a wrong value sends
# people to the wrong host. No trailing slash. Required in production.
PUBLIC_BASE_URL=https://ferencpalos.is-a.dev

# Path the app is mounted under, when it does not own the whole origin.
# Empty means the app serves from the root.
BASE_PATH=/adventures

# --- database ---------------------------------------------------------------
MONGODB_URI=mongodb://bucketlist-mongo:27017/bucketlist

# --- signups ----------------------------------------------------------------
# Closed unless this is exactly "true". While closed, accounts are made with
# scripts/createUser.js and no transactional email is needed at all.
SIGNUPS_OPEN=false

# --- email (Resend) ---------------------------------------------------------
# Only needed once SIGNUPS_OPEN=true. Without a key, mail is logged to the
# container output instead of sent, so nobody could verify or reset.
RESEND_API_KEY=
# Must be an address at a domain verified in your Resend dashboard.
MAIL_FROM=Adventures <hello@adventures.example.com>

# --- optional ---------------------------------------------------------------
PORT=3000
NODE_ENV=production
BRAND_NAME=Adventures
UPLOAD_DIR=/data/photos
# Host directory holding the photos and mongo volumes (see the compose file).
DATA_DIR=./data
USER_QUOTA_BYTES=262144000
# Shown on the privacy page. Falls back to the GitHub issue tracker if unset.
CONTACT_EMAIL=
