<%- include('header', { pageTitle: 'Settings' }) %>
<section class="narrow">
    <h1>Settings</h1>
    <%- include('_errors') %>

    <dl class="kv">
        <dt>Public map</dt>
        <dd><a href="<%= u('/u/' + currentUser.handle) %>"><%= u('/u/' + currentUser.handle) %></a></dd>
        <dt>Photo storage</dt>
        <dd><%= (currentUser.storageUsedBytes / 1048576).toFixed(1) %> MB used of <%= quotaMb %> MB</dd>
    </dl>

    <% if (!currentUser.emailVerifiedAt) { %>
        <div class="callout">
            <p>
                Confirm your email address to publish or share lists.
                Private lists work without it.
            </p>
            <form method="POST" action="<%= u('/verify/resend') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <button type="submit" class="button small">Send me a new link</button>
            </form>
        </div>
    <% } %>

    <h2>Profile</h2>
    <form method="POST" action="<%= u('/settings/profile') %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

        <div class="form-group">
            <label for="displayName">Name</label>
            <input id="displayName" name="displayName" maxlength="60" required
                   value="<%= form.displayName !== undefined ? form.displayName : currentUser.displayName %>">
            <% if (errors.displayName) { %><span class="error"><%= errors.displayName %></span><% } %>
        </div>

        <div class="form-group">
            <label for="handle">Handle</label>
            <input id="handle" name="handle" maxlength="30" required pattern="[a-z0-9-]{3,30}"
                   value="<%= form.handle !== undefined ? form.handle : currentUser.handle %>">
            <small>Your public map lives at /u/&lt;handle&gt;. Changing it breaks any link you have already shared.</small>
            <% if (errors.handle) { %><span class="error"><%= errors.handle %></span><% } %>
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" maxlength="254" required
                   value="<%= form.email !== undefined ? form.email : currentUser.email %>">
            <small>
                <% if (currentUser.emailVerifiedAt) { %>Verified.<% } else { %>Not verified.<% } %>
                Changing it needs your password below.
            </small>
            <% if (errors.email) { %><span class="error"><%= errors.email %></span><% } %>
        </div>

        <div class="form-group">
            <label for="profilePassword">Current password <small>(only needed to change your email)</small></label>
            <input id="profilePassword" name="currentPassword" type="password" autocomplete="current-password">
            <% if (errors.profilePassword) { %><span class="error"><%= errors.profilePassword %></span><% } %>
        </div>

        <div class="button-container"><button type="submit" class="button">Save profile</button></div>
    </form>

    <h2>Change password</h2>
    <form method="POST" action="<%= u('/settings/password') %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <div class="form-group">
            <label for="currentPassword">Current password</label>
            <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password">
            <% if (errors.currentPassword) { %><span class="error"><%= errors.currentPassword %></span><% } %>
        </div>
        <div class="form-group">
            <label for="newPassword">New password</label>
            <input id="newPassword" name="newPassword" type="password" minlength="10" required autocomplete="new-password">
            <% if (errors.newPassword) { %><span class="error"><%= errors.newPassword %></span><% } %>
        </div>
        <div class="button-container"><button type="submit" class="button">Update password</button></div>
    </form>

    <h2>Your data</h2>
    <p>Download everything this service holds about you as a JSON file.</p>
    <p><a href="<%= u('/settings/export') %>" class="button ghost">Export my data</a></p>

    <h2 class="danger-heading">Delete account</h2>
    <p>
        This removes your account, every list, every adventure and every photo,
        permanently. It cannot be undone.
    </p>
    <form method="POST" action="<%= u('/settings/delete') %>" novalidate
          onsubmit="return confirm('Permanently delete your account and everything in it?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <div class="form-group">
            <label for="deletePassword">Your password</label>
            <input id="deletePassword" name="password" type="password" required autocomplete="current-password">
            <% if (errors.deletePassword) { %><span class="error"><%= errors.deletePassword %></span><% } %>
        </div>
        <div class="form-group">
            <label for="confirmHandle">Type <strong><%= currentUser.handle %></strong> to confirm</label>
            <input id="confirmHandle" name="confirmHandle" required autocomplete="off">
            <% if (errors.confirmHandle) { %><span class="error"><%= errors.confirmHandle %></span><% } %>
        </div>
        <div class="button-container"><button type="submit" class="button delete">Delete my account</button></div>
    </form>
</section>
<%- include('footer') %>
