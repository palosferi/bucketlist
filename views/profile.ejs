<%- include('header', { pageTitle: profile.displayName + ' — adventures' }) %>
<section class="profile">
    <div class="page-head">
        <div>
            <h1><%= profile.displayName %></h1>
            <p class="meta">
                <%= publicAdventures.length %> public adventure<%= publicAdventures.length === 1 ? '' : 's' %>
                in <%= mapCountries.length %> countr<%= mapCountries.length === 1 ? 'y' : 'ies' %>
            </p>
        </div>
    </div>

    <% if (!mapCountries.length) { %>
        <p class="empty">No public adventures yet.</p>
    <% } else { %>
        <figure class="map-wrap">
            <div id="map" role="img"
                 aria-label="World map with <%= mapCountries.length %> countries highlighted">
            </div>
            <figcaption>
                Click a country to see its adventures. Scroll or pinch to zoom.
            </figcaption>
        </figure>

        <div id="country-detail" class="country-detail" hidden></div>

        <ul class="country-list">
            <% mapCountries.forEach(function (c) { %>
                <li>
                    <button type="button" class="country-chip" data-code="<%= c.code %>">
                        <span class="dot" style="background: <%= c.color %>"></span><%= c.name %>
                        <span class="count"><%= c.adventures.length %></span>
                    </button>
                </li>
            <% }) %>
        </ul>
    <% } %>
</section>

<script id="map-data" type="application/json"><%- JSON.stringify({
    basePath: basePath,
    countries: mapCountries.map(function (c) {
        return {
            code: c.code,
            numeric: alpha2ToNumeric[c.code] || null,
            name: c.name,
            color: c.color,
            listName: c.listName,
            adventures: c.adventures.map(function (a) {
                return {
                    name: a.name,
                    type: a.type,
                    date: a.date ? new Date(a.date).toISOString().slice(0, 10) : null,
                    done: a.done,
                    description: a.description,
                    photos: a.photos.map(function (p) { return p.filename })
                };
            })
        };
    })
}).replace(/</g, '\\u003c') %></script>

<script src="<%= u('/vendor/d3.min.js') %>" defer></script>
<script src="<%= u('/vendor/topojson-client.min.js') %>" defer></script>
<script src="<%= u('/map.js') %>" defer></script>
<%- include('footer') %>
