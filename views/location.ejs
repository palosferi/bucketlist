<%- include('header') %>
    <main>
        <form onsubmit="event.preventDefault(); window.location.href='/locations';">
            <div class="form-group">
                <label for="name">Name:</label>
                <input type="text" id="name" value="<%= typeof location === 'undefined' ? "" : location.name %>">
            </div>
            <div class="form-group">
                <label for="country">Country:</label>
                <input type="text" id="country" value="<%= typeof location === 'undefined' ? "" : location.country %>">
            </div>
            <div class="form-group">
                <label for="latitude">Latitude:</label>
                <input type="text" id="latitude" value="<%= typeof location === 'undefined' ? "" : location.nlatitudeame %>">
            </div>
            <div class="form-group">
                <label for="longitude">Longitude:</label>
                <input type="text" id="longitude" value="<%= typeof location === 'undefined' ? "" : location.longitude %>">
            </div>
            <div class="form-group">
                <label for="google-maps">Link:</label>
                <textarea id="google-maps" value="<%= typeof location === 'undefined' ? "" : location.google-maps %>"></textarea>
            </div>
            <div class="button-container">
                <button type="submit" class="button">Save</button>
                <button type="button" class="button delete" onclick="window.location.href='/locations';">Delete</button>
            </div>
        </form>
    </main>
<%- include('footer') %>
