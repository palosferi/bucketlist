<%- include('header') %>
    <main>
        <form method="POST" action="">
            <div class="form-group">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" value="<%= typeof location === 'undefined' ? "" : location.name %>">
            </div>
            <div class="form-group">
                <label for="country">Country:</label>
                <input type="text" id="country" name="country" value="<%= typeof location === 'undefined' ? "" : location.country %>">
            </div>
            <div class="form-group">
                <label for="latitude">Latitude:</label>
                <input type="text" id="latitude" name="latitude" value="<%= typeof location === 'undefined' ? "" : location.latitude %>">
            </div>
            <div class="form-group">
                <label for="longitude">Longitude:</label>
                <input type="text" id="longitude" name="longitude" value="<%= typeof location === 'undefined' ? "" : location.longitude %>">
            </div>
            <div class="form-group">
                <label for="googleMaps">Link:</label>
                <textarea id="googleMaps" name="googleMaps"><%= typeof location === 'undefined' ? "" : location.googleMaps %></textarea>
            </div>
            <div class="button-container">
                <button type="submit" class="button">Save</button>
                <button type="button" class="button delete" onclick="window.location.href='/locations';">Delete</button>
            </div>
        </form>
    </main>
<%- include('footer') %>
