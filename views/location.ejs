<%- include('header') %>
<main>
    <form method="POST" action="<%= location._id ? '/location/edit/' + location._id : '/location/new' %>">
        <div class="form-group">
            <label for="name">Name:</label>
            <input type="text" id="name" name="name" value="<%= location ? location.name : '' %>">
        </div>
        <div class="form-group">
            <label for="country">Country:</label>
            <input type="text" id="country" name="country" value="<%=  location ? location.country : '' %>">
        </div>
        <div class="form-group">
            <label for="latitude">Latitude:</label>
            <input type="text" id="latitude" name="latitude" value="<%= location ? location.latitude : '' %>">
        </div>
        <div class="form-group">
            <label for="longitude">Longitude:</label>
            <input type="text" id="longitude" name="longitude" value="<%=location ? location.longitude : '' %>">
        </div>
        <div class="form-group">
            <label for="link">Link:</label>
            <textarea id="link" name="link"><%= location ? location.link : '' %></textarea>
        </div>
        <div class="button-container">
            <button type="submit" class="button">Save</button>
        </div>
    </form>
    <% if (typeof location !== 'undefined') { %>
        <form method="POST" action="/location/delete/<%= location._id %>">
            <button type="submit" class="button delete">Delete</button>
        </form>
    <% } %>
</main>
<%- include('footer') %>
