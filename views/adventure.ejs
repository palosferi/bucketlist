<%- include('header') %>
<main>
  <form 
  method="POST" 
  action="<%= adventure && adventure._id 
             ? '/adventure/edit/' + adventure._id 
             : '/adventure/new' 
           %>"
  >
        <div class="form-group">
            <label for="name">Name:</label>
            <input type="text" id="name" name="name" value="<%= adventure ? adventure.name : '' %>">
        </div>
        <div class="form-group">
            <label for="type">Type:</label>
            <input type="text" id="type" name="type" value="<%= adventure ? adventure.type : '' %>">
        </div>
        <div class="form-group">
            <label for="date">Date:</label>
            <input type="date" id="date" name="date" value="<%= adventure ? adventure.date : '' %>">
        </div>
        <div class="form-group">
            <label for="_location">Location:</label>
            <select name="_location">
                <% locations.forEach(loc => { %>
                  <option value="<%= loc._id %>"
                    <%= adventure && adventure._location && adventure._location.toString() === loc._id.toString()
                        ? ' selected'
                        : '' %>>
                    <%= loc.name %>
                  </option>
                <% }) %>
              </select>
        </div>
        <div class="form-group">
            <label for="description">Description:</label>
            <textarea id="description" name="description"><%= adventure ? adventure.description : '' %></textarea>
        </div>
        <div class="button-container">
          <button type="submit" class="button">Save</button>
          <% if (adventure && adventure._id) { %>
            <button 
              type="submit" 
              class="button delete"
              formaction="/adventure/delete/<%= adventure._id %>"
              formmethod="POST"
              formnovalidate
            >
              Delete
            </button>
          <% } else { %>
            <a href="/adventures" class="button delete">
              Cancel
            </a>
          <% } %>
        </div>
      </form>
</main>
<%- include('footer') %>
