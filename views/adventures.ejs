<%- include('header') %>
<main>
    <div class="button-container">
        <a href="/adventure/new" class="button">New Adventure</a>
    </div>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Date</th>
                <th>Location</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <% for (let i = 0; i < adventures.length; i++) { 
                const adventure = adventures[i]; %>
                <tr>
                    <td><a href="/adventure/edit/<%= adventure._id %>"><%= adventure.name %></a></td>
                    <td><%= adventure.type %></td>
                    <td><%= adventure.date %></td>
                    <td><a href="/location/edit/<%= adventure._id %>"><%= adventure._location?.name || 'Unknown' %></a></td>
                    <td><%= adventure.description %></td>
                </tr>
            <% } %>
        </tbody>
    </table>
</main>
<%- include('footer') %>
