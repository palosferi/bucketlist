<%- include('header', { pageTitle: 'All adventures' }) %>
<section>
    <div class="page-head">
        <h1>All adventures</h1>
        <a href="<%= u('/adventures/new') %>" class="button">New adventure</a>
    </div>
    <% if (!adventures.length) { %>
        <p class="empty">No adventures yet.</p>
    <% } else { %>
        <ul class="adventure-list">
            <% adventures.forEach(function (adventure) { %>
                <%- include('_adventureRow', { adventure: adventure }) %>
            <% }) %>
        </ul>
    <% } %>
</section>
<%- include('footer') %>
