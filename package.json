{
  "name": "bucketlist",
  "version": "1.0.0",
  "description": "Private bucketlist logging with a public adventure map",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest .",
    "test-coverage": "jest --coverage",
    "gen:countries": "node scripts/genCountries.js > lib/countries.js",
    "gen:map": "cp node_modules/world-atlas/countries-50m.json public/world-50m.json"
  },
  "repository": {
    "type": "git",
