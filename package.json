  },
  "homepage": "https://github.com/palosferi/bucketlist#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "connect-mongo": "^5.1.0",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.13.2",
    "multer": "^2.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
